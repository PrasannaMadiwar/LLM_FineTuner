DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DATABASE_SCHEMA=llm_finetuner
REDIS_URL=redis://default:PASSWORD@HOST:PORT/0
CELERY_BROKER_URL=redis://default:PASSWORD@HOST:PORT/0
CELERY_RESULT_BACKEND=redis://default:PASSWORD@HOST:PORT/0
LOCAL_POSTGRES_DB=llm_finetuner
LOCAL_POSTGRES_USER=llm_finetuner
LOCAL_POSTGRES_PASSWORD=llm_finetuner_password
LOCAL_DATABASE_URL=postgresql+asyncpg://llm_finetuner:llm_finetuner_password@postgres:5432/llm_finetuner
LOCAL_REDIS_URL=redis://redis:6379/0
LOCAL_CELERY_BROKER_URL=redis://redis:6379/0
LOCAL_CELERY_RESULT_BACKEND=redis://redis:6379/0
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
STORAGE_PATH=storage
GPU_AGENT_TOKEN=change-me-runtime-agent-token
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_CORS_ORIGINS=http://localhost:13000,http://localhost:3000,http://localhost:18000
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000/api/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# local = run training on this machine's GPU through Docker (demo); runpod = RunPod cloud GPUs
GPU_PROVIDER=local
LOCAL_GPU_IMAGE=llm-finetuner-gpu-agent:local
# Caps rows written per normalized dataset so demo training finishes in minutes; remove the line for no cap
DATASET_MAX_ROWS=2000
RUNPOD_API_KEY=
RUNPOD_TEMPLATE_ID=
# A RunPod gpuTypeId (e.g. "NVIDIA A100 80GB PCIe"), an alias (A100, H100, A40, L40S, L4, RTX4090), or a comma-separated list
RUNPOD_DEFAULT_GPU=A100
RUNPOD_VOLUME_SIZE=100
RUNPOD_CONTAINER_DISK=50
RUNPOD_REGION=
RUNPOD_AGENT_PORT=8001
RUNPOD_CLOUD_TYPE=SECURE
# The agent image uses CUDA 12.8; pods are only placed on hosts whose driver supports these versions
RUNPOD_ALLOWED_CUDA_VERSIONS=12.8,12.9,13.0
GPU_CREATE_TIMEOUT_SECONDS=900
GPU_OPERATION_MAX_RETRIES=3
TRAINING_WORKER_POLL_INTERVAL_SECONDS=10
TRAINING_WORKER_POLL_TIMEOUT_SECONDS=86400
